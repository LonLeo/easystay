NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=easystay_db
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
# Creates missing tables/indexes only when explicitly enabled; never uses alter:true.
DB_SYNC=false
# Legacy destructive sample seeder is disabled unless explicitly enabled.
ALLOW_DESTRUCTIVE_SEED=false
SEED_PASSWORD=
